# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# Only required if data.provider or news.provider is set to "alpaca" in
# config/config.yaml. Get free paper-trading keys at https://alpaca.markets/
# These are DATA credentials only - this project never places real trades.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Overrides config/config.yaml's database.url. Useful in Docker where the
# Postgres service is reachable by hostname rather than localhost.
# Example: postgresql+psycopg2://stockbot:stockbot@postgres:5432/stockbot
DATABASE_URL=

# Overrides config/config.yaml's log_level.
LOG_LEVEL=INFO
